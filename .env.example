# CivicPlexus environment variables — copy to .env and fill in.
# Never commit a real .env. SUPABASE_SERVICE_ROLE_KEY is server-only.

# --- Public (browser + server) ---
VITE_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="eyJhbGciOi..."   # anon / publishable key
VITE_SUPABASE_PROJECT_ID="YOUR-PROJECT"

# --- Server only (mirror of VITE_* for SSR + privileged ops) ---
SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
SUPABASE_PUBLISHABLE_KEY="eyJhbGciOi..."
SUPABASE_PROJECT_ID="YOUR-PROJECT"
SUPABASE_SERVICE_ROLE_KEY=""                    # privileged — Auth admin, webhooks
SUPABASE_DB_URL="postgresql://postgres:PASSWORD@db.YOUR-PROJECT.supabase.co:5432/postgres"

# --- AI provider (pluggable; default lovable) ---
AI_PROVIDER="lovable"                           # lovable | openai | azure | none
LOVABLE_API_KEY=""                              # required when AI_PROVIDER=lovable
OPENAI_API_KEY=""                               # required when AI_PROVIDER=openai
AZURE_OPENAI_ENDPOINT=""                        # required when AI_PROVIDER=azure
AZURE_OPENAI_API_KEY=""

# --- Webhook / inbound signing secrets ---
REMINDERS_WEBHOOK_SECRET=""                     # HMAC-SHA256 for /api/public/hooks/reminders

# --- Optional integrations ---
RESEND_API_KEY=""                               # transactional email
SENTRY_DSN=""                                   # error reporting (off when empty)